{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "调试 cpp_server",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/cpp_server",
            "args": ["--port", "8080"],
            "cwd": "${workspaceFolder}",
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "启用 gdb 整齐打印",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "cmake build"
        }
    ]
}
